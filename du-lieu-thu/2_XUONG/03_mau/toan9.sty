% =====================================================================
%  toan9.sty  —  Mẫu chung cho tài liệu Toán 9 (biên dịch bằng XeLaTeX)
%  Bản HS / GV: một nguồn, hai bản. Công tắc \ifGV.
%    - Biên dịch trực tiếp file .tex  -> bản GV (có lời giải).
%    - Bản HS: xuat.ps1 định nghĩa \BANHS trước khi nạp file.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{toan9}[2026/10/26 Mau tai lieu Toan 9]

% ---------- Công tắc HS / GV ----------
\newif\ifGV
\ifdefined\BANHS \GVfalse \else \GVtrue \fi

% ---------- Trang, phông ----------
\RequirePackage[a4paper,top=1.8cm,bottom=1.8cm,left=2cm,right=1.6cm,headsep=0.5cm]{geometry}
% Lưu ý: newtxmath làm XeLaTeX (MiKTeX trên máy) treo khi gặp \geqslant -> dùng unicode-math
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\setmainfont{Times New Roman}
\setmathfont{texgyretermes-math.otf}
\linespread{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}

\RequirePackage{enumitem,multicol,array,tabularx,xcolor,graphicx}
\RequirePackage{tikz,tkz-euclide}
\usetikzlibrary{calc,angles,quotes,intersections,patterns,arrows.meta}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}

% ---------- Màu ----------
\definecolor{xanh}{HTML}{1F4E79}
\definecolor{xanhnhat}{HTML}{EAF1F8}
\definecolor{cam}{HTML}{C55A11}
\definecolor{xam}{HTML}{6B6B6B}

% ---------- Danh mục chuẩn & thông tin tài liệu ----------
% Tên lấy từ danhmuc.tex. Trong file .tex ghi: \loai{1}\chuong{3} | \loai{2}\chuyende{1} | \loai{3}\de{01}
\newcommand{\dmuc}[2]{\expandafter\def\csname dm@#1\endcsname{#2}}
\newcommand{\dmucngan}[2]{\expandafter\def\csname dm@#1@ngan\endcsname{#2}}
\newcommand{\laydm}[1]{\ifcsname dm@#1\endcsname\csname dm@#1\endcsname
  \else\PackageError{toan9}{Danh muc chua co muc '#1' (xem danhmuc.tex)}{}\fi}
\newcommand{\laydmngan}[1]{\ifcsname dm@#1@ngan\endcsname\csname dm@#1@ngan\endcsname\else\laydm{#1}\fi}
\input{danhmuc.tex}

\newcommand{\tenbo}{}        % bên phải đầu trang: tên bộ tài liệu
\newcommand{\tentailieu}{}   % tên đầy đủ: chương / chuyên đề / đề (dùng trong tiêu đề)
\newcommand{\tendau}{}       % tên trên đầu trang (bản ngắn nếu danh mục có)
\newcommand{\loai}[1]{\renewcommand{\tenbo}{\laydm{loai#1}}}
\newcommand{\chuong}[1]{\renewcommand{\tentailieu}{\laydm{chuong#1}}\renewcommand{\tendau}{\laydmngan{chuong#1}}}
\newcommand{\chuyende}[1]{\renewcommand{\tentailieu}{\laydm{chuyende#1}}\renewcommand{\tendau}{\laydmngan{chuyende#1}}}
\newcommand{\de}[1]{\renewcommand{\tentailieu}{Đề số #1}\renewcommand{\tendau}{Đề số #1}}
\newcommand{\dattentailieu}[1]{\renewcommand{\tentailieu}{#1}\renewcommand{\tendau}{#1}}  % đặt tay khi cần

% Bên trái đầu trang: nếu vẫn quá dài thì tự thu nhỏ cho vừa, không đè lên tên bộ bên phải
\newsavebox{\hopdau}
\newcommand{\daugoc}{\sbox{\hopdau}{\footnotesize\color{xam}\tendau}%
  \ifdim\wd\hopdau>0.6\textwidth\resizebox{0.6\textwidth}{!}{\usebox{\hopdau}}\else\usebox{\hopdau}\fi}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\daugoc}
\fancyhead[R]{\footnotesize\bfseries\color{xanh}\tenbo}
\fancyfoot[L]{\small\color{xanh}Giỏi Toán cùng Trí Trí - ĐT: 0827.06.05.99}
\fancyfoot[R]{\small Trang \thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% ---------- Tiêu đề ----------
% \tieude{\tentailieu}{Bài 7. Căn bậc hai và căn thức bậc hai}  (dòng trên lấy tên chương từ danh mục)
% Nhiều bài trong một file: bài đầu \tieude{\tentailieu}{...}, các bài sau \tieude{}{...} (không lặp tên chương)
% và \baimoi trước mỗi bài để đánh số dạng, bài tập, ví dụ lại từ 1.
\newcommand{\baimoi}{\setcounter{dang}{0}\setcounter{bt}{0}\setcounter{vd}{0}}
\newcommand{\tieude}[2]{%
  \cophanfalse\dautrang{0}{\if\relax\detokenize{#2}\relax#1\else#2\fi}%
  \begin{center}
    \if\relax\detokenize{#1}\relax\else{\large\bfseries\color{xanh}\MakeUppercase{#1}}\par\vspace{2pt}\fi
    {\Large\bfseries\color{xanh}\MakeUppercase{#2}}
  \end{center}\vspace{4pt}}

% Phần lớn: A. KIẾN THỨC CẦN NHỚ / B. CÁC DẠNG BÀI TẬP / C. BÀI TẬP TỰ LUYỆN
\newcommand{\phan}[1]{\par\cophantrue\dautrang{1}{#1}\medskip{\large\bfseries\color{xanh}\MakeUppercase{#1}}\par\smallskip}

% Dạng bài: \dang{Tìm căn bậc hai của một số}
\newcounter{dang}
\newcommand{\dang}[1]{\par\medskip\refstepcounter{dang}\ifcophan\dautrang{2}{Dạng \thedang. #1}\else\dautrang{1}{Dạng \thedang. #1}\fi%
  \begin{tcolorbox}[colback=xanh,colframe=xanh,coltext=white,boxrule=0pt,arc=2pt,
    left=6pt,right=6pt,top=3pt,bottom=3pt,before skip=6pt,after skip=4pt]
  \bfseries Dạng \thedang. #1\end{tcolorbox}}

% Hộp kiến thức / phương pháp
\newtcolorbox{kienthuc}{breakable,enhanced,colback=xanhnhat,colframe=xanh,
  boxrule=0.6pt,arc=2pt,left=6pt,right=6pt,top=4pt,bottom=4pt}
\newtcolorbox{phuongphap}{breakable,enhanced,colback=white,colframe=cam,boxrule=0.5pt,
  borderline west={2.5pt}{0pt}{cam},arc=0pt,left=8pt,top=2pt,bottom=2pt,
  before upper={\textbf{\color{cam}Phương pháp.}\ }}

% ---------- Bài tập ----------
% \begin{bt} Đề bài ... \loigiai{...} \end{bt}
% Nhãn mức độ (tuỳ chọn, chỉ hiện ở bản GV): \begin{bt}[TH]
\newcounter{bt}
\newenvironment{bt}[1][]{\par\smallskip\refstepcounter{bt}%
  \noindent{\bfseries\color{xanh}Bài \thebt.}%
  \ifGV\if\relax\detokenize{#1}\relax\else\ {\footnotesize\color{xam}[Mức #1]}\fi\fi\ \ignorespaces}%
  {\par}

% Ví dụ có lời giải mẫu (in ở cả hai bản)
\newcounter{vd}
\newenvironment{vd}{\par\smallskip\refstepcounter{vd}%
  \noindent{\bfseries\color{cam}Ví dụ \thevd.}\ \ignorespaces}{\par}
\newcommand{\giai}[1]{\par{\itshape\bfseries Lời giải.}\ #1\par}

% Lời giải: chỉ in ở bản GV
\newtcolorbox{hopgiai}{breakable,enhanced,colback=white,colframe=xam,boxrule=0pt,
  borderline west={1.5pt}{0pt}{xanh},arc=0pt,left=8pt,right=0pt,top=1pt,bottom=1pt,
  before skip=2pt,after skip=4pt,
  before upper={{\bfseries\itshape\color{xanh}Lời giải.}\ }}
\newcommand{\loigiai}[1]{\ifGV\begin{hopgiai}#1\end{hopgiai}\fi}
% Đáp số ngắn (bài tự luyện): chỉ in ở bản GV
\newcommand{\dapso}[1]{\ifGV\par{\bfseries\color{xanh}Đáp số:}\ #1\par\fi}

% ---------- Trắc nghiệm 4 phương án ----------
% \pa{..}{..}{..}{..} (tự xếp 4/2/1 cột theo độ dài bằng \pa, \paa, \paaa)
% Đánh dấu đáp án đúng: \dung{...} — bản GV in đậm, gạch chân.
\newcommand{\dung}[1]{\ifGV\underline{\textbf{#1}}\else#1\fi}
\newcommand{\pa}[4]{\par\noindent
  \begin{tabularx}{\linewidth}{@{}XXXX@{}}\textbf{A.}~#1&\textbf{B.}~#2&\textbf{C.}~#3&\textbf{D.}~#4\end{tabularx}\par}
\newcommand{\paa}[4]{\par\noindent
  \begin{tabularx}{\linewidth}{@{}XX@{}}\textbf{A.}~#1&\textbf{B.}~#2\\\textbf{C.}~#3&\textbf{D.}~#4\end{tabularx}\par}
\newcommand{\paaa}[4]{\par\noindent\textbf{A.}~#1\par\noindent\textbf{B.}~#2\par\noindent\textbf{C.}~#3\par\noindent\textbf{D.}~#4\par}

% Ý nhỏ a), b), c) xếp theo hàng ngang: \begin{cacy}(2) \item ... \item ... \end{cacy}
% Số cột ghi trong ngoặc tròn, bỏ trống = 1 cột.
\RequirePackage{tasks}
\NewTasksEnvironment[label=\alph*),label-width=1.3em,item-indent=1.6em,
  before-skip=1pt,after-skip=2pt,after-item-skip=2pt]{cacy}[\item](1)

% Ô giữ chỗ hình vẽ (từ bản số hóa, chờ vẽ lại bằng TikZ): \hinhcho{số trang gốc}{mô tả}
\newcommand{\hinhcho}[2]{\par\begin{center}\fcolorbox{cam}{white}{\parbox{0.8\linewidth}{\footnotesize
  \textbf{\color{cam}[Hình — trang #1]}\ #2}}\end{center}}
% Hình gốc cắt từ PDF nguồn: \hinhgoc{13CD/CD10_hinh/t424-1.pdf}{mô tả (không in, để dành khi cần vẽ lại)}
% Đường dẫn tính từ 2_XUONG/02_ngan-hang/; xuat.py và kiem_tra.py tự chép file hình khi biên dịch.
\RequirePackage[export]{adjustbox}
\newcommand{\hinhgoc}[2]{\par\begin{center}\includegraphics[max width=0.6\linewidth]{#1}\end{center}}
% Chỗ bản số hóa chưa đọc rõ: \chuaro{?}
\newcommand{\chuaro}[1]{\colorbox{yellow}{\textbf{#1}}}

% Lệnh toán hay dùng
\newcommand{\heva}[1]{\left\{\begin{aligned}#1\end{aligned}\right.}
\newcommand{\hoac}[1]{\left[\begin{aligned}#1\end{aligned}\right.}
\providecommand{\wideparen}[1]{\mathop{\overset{\frown}{#1}}}  % cung AB
\providecommand{\overarc}[1]{\wideparen{#1}}
\providecommand{\widearc}[1]{\wideparen{#1}}
% Kiểu Việt Nam: ≥ ≤ viết nghiêng (⩾ ⩽)
\AtBeginDocument{\let\geq\geqslant\let\ge\geqslant\let\leq\leqslant\let\le\leqslant}

% ---------- Dấu trang: mục lục trong PDF, hiện ở thanh bên của app ----------
% \tieude là cấp 0, \phan cấp 1, \dang cấp 2. hidelinks để chữ không bị khung màu.
\RequirePackage[unicode,bookmarksopen=true,hidelinks]{hyperref}
\newif\ifcophan  % đã có \phan trước \dang chưa: có thì \dang nằm cấp 2, chưa thì cấp 1 (tránh nhảy cấp làm mục lục lồng sai)
\newcounter{dautrang}
\newcommand{\dautrang}[2]{\refstepcounter{dautrang}\pdfbookmark[#1]{#2}{dautrang.\thedautrang}}

\endinput
