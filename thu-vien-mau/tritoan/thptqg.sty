% =====================================================================
%  thptqg.sty — ĐỀ THI TỐT NGHIỆP THPT (kiểu Bộ GD&ĐT). In đen trắng. Ba phần trắc nghiệm.
%  Dựng trên kiem_tra_thpt.sty: mọi thứ giống hệt (câu hỏi kéo từ ngân hàng, file bài tập sang dùng ngay;
%  chân trang như tài liệu; trang cuối tự có "--- HẾT ---"), CHỈ KHÁC phần đầu đề.
%
%  Dùng:  \usepackage{thptqg}
%  Lệnh riêng:
%    \namthi{2026}      năm thi (mặc định 2026)
%    \tende{..}         tên đề trong khung ô trái, ví dụ \tende{Đề thi thử 01}, \tende{Đề minh họa 01}
%                       (mặc định "ĐỀ THI THỬ"; \dechinhthuc, \dethamkhao cũ vẫn dùng được)
%    \so{..}            dòng trên ô trái (mặc định "GIỎI TOÁN CÙNG TRÍ TRÍ")
%    \mon{TOÁN}  \thoigian{90 phút}  \made{0101}
%    \kythi{...}        đổi cả dòng kỳ thi nếu cần (mặc định KỲ THI TỐT NGHIỆP TRUNG HỌC PHỔ THÔNG NĂM ...)
%  Cấu trúc: \taodaude, \phantn (I), \phands (II), \phantln (III), \bangdapan
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thptqg}[2026/11/12 De thi tot nghiep THPT]
\RequirePackage{kiem_tra_thpt}

% ---------- Thông tin đề ----------
\newcommand{\tt@namthi}{2026}
% Tên đề trong khung ô trái do người soạn đặt: \tende{Đề thi thử 01}, \tende{Đề minh họa 01}... (in chữ hoa)
\newcommand{\tt@loaide}{Đề thi thử}
\renewcommand{\tende}[1]{\renewcommand{\tt@loaide}{#1}}
\newcommand{\namthi}[1]{\renewcommand{\tt@namthi}{#1}}
\newcommand{\dechinhthuc}{\renewcommand{\tt@loaide}{ĐỀ THI CHÍNH THỨC}}
\newcommand{\dethamkhao}{\renewcommand{\tt@loaide}{ĐỀ THAM KHẢO}}
% Dòng trên ô trái: giữ "Giỏi Toán cùng Trí Trí" của kiem_tra_thpt (đổi bằng \so{..})
\renewcommand{\tt@kythi}{KỲ THI TỐT NGHIỆP TRUNG HỌC PHỔ THÔNG NĂM \tt@namthi}
\renewcommand{\tt@thoigian}{90 phút}

% ---------- Đầu đề kiểu Bộ: trái Bộ GD&ĐT và loại đề, phải kỳ thi, môn thi, thời gian ----------
\renewcommand{\taodaude}{%
  \noindent\begin{tabularx}{\linewidth}{@{}>{\centering\arraybackslash}p{0.38\linewidth}
      >{\centering\arraybackslash}X@{}}
    \bfseries\MakeUppercase{\tt@so} & \bfseries\MakeUppercase{\tt@kythi}\\[2pt]
    \fbox{\bfseries\ \MakeUppercase{\tt@loaide}\ } &\bfseries Môn thi: \tenmon\\[2pt]
    \itshape(Đề thi có \pageref*{LastPage} trang) & \itshape Thời gian làm bài: \tt@thoigian\\
    & \itshape(không kể thời gian phát đề)\\
  \end{tabularx}\par\medskip
  \noindent Họ, tên thí sinh: \makebox[6.3cm]{\dotfill}\quad Số báo danh: \makebox[2.6cm]{\dotfill}%
  \if\relax\detokenize\expandafter{\tt@made}\relax\else
    \hfill\fbox{\bfseries Mã đề \tt@made}\fi
  \par\medskip}
\endinput
