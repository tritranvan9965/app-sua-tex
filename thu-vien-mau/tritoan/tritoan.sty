% =====================================================================
%  tritoan.sty  —  LÕI CHUNG cho mọi tài liệu Toán (biên dịch bằng XeLaTeX)
%
%  Không dùng trực tiếp. Mỗi lớp có một file mỏng gọi lõi này:
%     toan9.sty, toan10.sty, toan11.sty, toan12.sty
%  File lớp chỉ nạp danh mục của lớp và ghi đè vài giá trị (tên môn, chân trang, màu...).
%
%  Quy ước để sửa ít:
%    - Sửa giao diện chung (phông, màu, hộp, cách in câu hỏi) thì sửa Ở ĐÂY, mọi lớp tự nhận.
%    - Thứ riêng của một lớp thì để trong file lớp, dùng \renewcommand để ghi đè.
%    - Không xoá hay đổi nghĩa lệnh cũ, để tài liệu đã viết vẫn biên dịch được.
%    - Lệnh nội bộ có chữ @ (\tt@...), người viết tài liệu không dùng.
%
%  Bản HS / GV: một nguồn, hai bản. Công tắc \ifGV.
%    - Biên dịch thẳng file .tex  -> bản GV (có lời giải, đáp án).
%    - Bản HS: định nghĩa \BANHS trước khi nạp mẫu (app TriTeX tự làm khi dự án có cấu hình hai bản).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tritoan}[2026/11/07 Loi chung tai lieu Toan]

% ---------- Công tắc HS / GV ----------
\newif\ifGV
\ifdefined\BANHS \GVfalse \else \GVtrue \fi

% ---------- Trang, phông ----------
\RequirePackage[a4paper,top=1.8cm,bottom=1.8cm,left=2cm,right=1.6cm,headsep=0.5cm,headheight=15pt]{geometry}
% Lưu ý: newtxmath làm XeLaTeX (MiKTeX trên máy) treo khi gặp \geqslant -> dùng unicode-math
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\setmainfont{Times New Roman}
\setmathfont{texgyretermes-math.otf}
\linespread{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}

\RequirePackage{enumitem,multicol,array,tabularx,xcolor,graphicx}
\RequirePackage{tikz,tkz-euclide}
\usetikzlibrary{calc,angles,quotes,intersections,patterns,arrows.meta}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}

% ---------- Màu (file lớp có thể ghi đè bằng \definecolor) ----------
\definecolor{xanh}{HTML}{14284B}% navy: in đen trắng vẫn rõ
\definecolor{xanhnhat}{HTML}{EAF1F8}
\definecolor{cam}{HTML}{C55A11}
\definecolor{camnhat}{HTML}{FBEADF}
\definecolor{xam}{HTML}{6B6B6B}

% ---------- Giá trị file lớp hay ghi đè ----------
\newcommand{\tenmon}{TOÁN}                                        % file lớp: \renewcommand{\tenmon}{TOÁN 10}
\newcommand{\mon}[1]{\renewcommand{\tenmon}{#1}}                  % cách gọn: \mon{TOÁN 10}
\newcommand{\chantrang}{Giỏi Toán cùng Trí Trí - ĐT: 0827.06.05.99}  % dòng bên trái chân trang

% ---------- Danh mục chuẩn & thông tin tài liệu ----------
% Tên lấy từ danh mục của lớp (danhmuc10.tex...). Trong file .tex ghi:
%   \loai{1}\chuong{3}   |   \loai{2}\de{01}   |   \loai{3}\chuyende{1}
\newcommand{\dmuc}[2]{\expandafter\def\csname dm@#1\endcsname{#2}}
\newcommand{\dmucngan}[2]{\expandafter\def\csname dm@#1@ngan\endcsname{#2}}
\newcommand{\laydm}[1]{\ifcsname dm@#1\endcsname\csname dm@#1\endcsname
  \else\PackageError{tritoan}{Danh muc chua co muc '#1' (xem file danhmuc cua lop)}{}\fi}
\newcommand{\laydmngan}[1]{\ifcsname dm@#1@ngan\endcsname\csname dm@#1@ngan\endcsname\else\laydm{#1}\fi}

\newcommand{\tenbo}{}        % bên phải đầu trang: tên bộ tài liệu
\newcommand{\tentailieu}{}   % tên đầy đủ: chương / chuyên đề / đề (dùng trong tiêu đề)
\newcommand{\tendau}{}       % tên trên đầu trang (bản ngắn nếu danh mục có)
\newcommand{\loai}[1]{\renewcommand{\tenbo}{\laydm{loai#1}}}
\newcommand{\chuong}[1]{\renewcommand{\tentailieu}{\laydm{chuong#1}}\renewcommand{\tendau}{\laydmngan{chuong#1}}}
\newcommand{\chuyende}[1]{\renewcommand{\tentailieu}{\laydm{chuyende#1}}\renewcommand{\tendau}{\laydmngan{chuyende#1}}}
\newcommand{\de}[1]{\renewcommand{\tentailieu}{Đề số #1}\renewcommand{\tendau}{Đề số #1}}
\newcommand{\dattentailieu}[1]{\renewcommand{\tentailieu}{#1}\renewcommand{\tendau}{#1}}  % đặt tay khi cần

% Bên trái đầu trang: nếu vẫn quá dài thì tự thu nhỏ cho vừa, không đè lên tên bộ bên phải
\newsavebox{\hopdau}
\newcommand{\daugoc}{\sbox{\hopdau}{\footnotesize\color{xam}\tendau}%
  \ifdim\wd\hopdau>0.6\textwidth\resizebox{0.6\textwidth}{!}{\usebox{\hopdau}}\else\usebox{\hopdau}\fi}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\daugoc}
\fancyhead[R]{\footnotesize\bfseries\color{xanh}\tenbo}
\fancyfoot[L]{\small\color{xanh}\chantrang}
\fancyfoot[R]{\small Trang \thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% ---------- Tiêu đề ----------
% \tieude{\tentailieu}{Bài 1. Mệnh đề}  (dòng trên lấy tên chương từ danh mục)
% Nhiều bài trong một file: bài đầu \tieude{\tentailieu}{...}, các bài sau \tieude{}{...} (không lặp tên chương)
% và \baimoi trước mỗi bài để đánh số dạng, bài, ví dụ, câu lại từ 1.
\newcommand{\baimoi}{\setcounter{dang}{0}\setcounter{bt}{0}\setcounter{vd}{0}\setcounter{cau}{0}}
\newcommand{\tieude}[2]{%
  \tt@xoacho\cophanfalse\dautrang{0}{\if\relax\detokenize{#2}\relax#1\else#2\fi}%
  \begin{center}
    \if\relax\detokenize{#1}\relax\else{\large\bfseries\color{xanh}\MakeUppercase{#1}}\par\vspace{2pt}\fi
    {\Large\bfseries\color{xanh}\MakeUppercase{#2}}
  \end{center}\vspace{4pt}}

% Phần lớn: A. LÝ THUYẾT / B. PHÂN LOẠI VÀ PHƯƠNG PHÁP GIẢI TOÁN
\RequirePackage{needspace}% đề mục không nằm trơ cuối trang: thiếu chỗ thì sang trang cùng câu đầu tiên
\newcommand{\tt@phancu}[1]{\par\needspace{6\baselineskip}\cophantrue\dautrang{1}{#1}\medskip{\large\bfseries\color{xanh}\MakeUppercase{#1}}\par\smallskip}

% Dạng bài: \dang{Xét tính đúng sai của mệnh đề}
\newcounter{dang}
\newcommand{\dang}[1]{\tt@xoacho\par\needspace{8\baselineskip}\medskip\refstepcounter{dang}\ifcophan\dautrang{2}{Dạng \thedang. #1}\else\dautrang{1}{Dạng \thedang. #1}\fi%
  \begin{tcolorbox}[colback=xanh,colframe=xanh,coltext=white,boxrule=0pt,arc=2pt,
    left=6pt,right=6pt,top=3pt,bottom=3pt,before skip=6pt,after skip=4pt]
  \bfseries Dạng \thedang. #1\end{tcolorbox}}

% Đề mục loại bài trong một dạng: dải nền cam nhạt, vạch cam bên trái, chữ navy.
% Học sinh lướt trang là thấy chỗ bắt đầu từng loại bài. Có dấu trang PDF, cấp con dưới Dạng.
\newcommand{\tt@inmuc}[1]{\par\needspace{5\baselineskip}\smallskip\ifcophan\dautrang{3}{#1}\else\dautrang{2}{#1}\fi%
  \begin{tcolorbox}[enhanced,colback=camnhat,colframe=cam,boxrule=0pt,leftrule=4pt,arc=0pt,outer arc=0pt,
    left=8pt,right=6pt,top=3pt,bottom=3pt,before skip=8pt,after skip=5pt]
  {\large\bfseries\color{xanh}#1}\end{tcolorbox}}
\newcommand{\muctl}{\tt@xoacho\tt@inmuc{Bài tập tự luận}}
\newcommand{\muctn}{\tt@xoacho\tt@inmuc{Trắc nghiệm nhiều phương án}}
\newcommand{\mucds}{\tt@xoacho\tt@inmuc{Câu hỏi đúng sai}}
\newcommand{\muctln}{\tt@xoacho\tt@inmuc{Câu hỏi trả lời ngắn}}
\newcommand{\tt@chuchung}{}
\newcommand{\tt@mucchung}{\tt@inmuc{\tt@chuchung}}

% File cũ viết đề mục loại bài bằng \phan hay \muc với nhiều cách gọi (BÀI TẬP TỰ LUẬN, II. BÀI TẬP TỰ LUẬN,
% PHẦN I. Câu trắc nghiệm nhiều phương án..., Chọn đáp án đúng nhất, Đúng ghi Đ, sai ghi S, Trả lời ngắn...).
% Mẫu tự nhận ra và in thành dải đề mục như bốn đề mục chuẩn ở trên, GIỮ NGUYÊN chữ người soạn đã viết, nên không phải sửa file nào.
% "BÀI TẬP TRẮC NGHIỆM" chung: chờ xem; gặp đề mục con thì bỏ, gặp câu hỏi trước thì in "Bài tập trắc nghiệm".
\ExplSyntaxOn
\tl_new:N \l__tt_dm_tl
\tl_new:N \l__tt_dmhoa_tl
\bool_new:N \g__tt_muccho_bool
\cs_new_protected:Npn \tt@xoacho { \bool_gset_false:N \g__tt_muccho_bool }
\cs_new_protected:Npn \tt@cho
  {
    \bool_if:NT \g__tt_muccho_bool
      { \bool_gset_false:N \g__tt_muccho_bool \tt@mucchung }
  }
% Chữ đề mục -> \l__tt_dm_tl: tl, tn, ds, tln, chung; rỗng nếu không phải đề mục loại bài.
\cs_new_protected:Npn \__tt_loai_dm:n #1
  {
    \tl_set:Nx \l__tt_dmhoa_tl { \text_uppercase:n {#1} }
    \regex_replace_all:nnN { \s+ } { \  } \l__tt_dmhoa_tl
    \regex_replace_once:nnN { \A \s* (?: PHẦN \s+ )? (?: [IVX]+ | [A-Z] ) [\.\)] \s* } { } \l__tt_dmhoa_tl
    \tl_clear:N \l__tt_dm_tl
    \regex_match:nVT { \A BÀI\ TẬP\ TRẮC\ NGHIỆM \s* [\.\:]? \s* \Z } \l__tt_dmhoa_tl
      { \tl_set:Nn \l__tt_dm_tl { chung } }
    \regex_match:nVT { \A (?: BÀI\ TẬP\ )? TỰ\ LUẬN } \l__tt_dmhoa_tl
      { \tl_set:Nn \l__tt_dm_tl { tl } }
    \regex_match:nVT { \A (?: (?: CÂU\ )? TRẮC\ NGHIỆM\ NHIỀU\ PHƯƠNG\ ÁN | CHỌN\ ĐÁP\ ÁN\ ĐÚNG ) } \l__tt_dmhoa_tl
      { \tl_set:Nn \l__tt_dm_tl { tn } }
    \regex_match:nVT { \A (?: (?: CÂU\ )? TRẮC\ NGHIỆM\ ĐÚNG\ SAI | CÂU\ HỎI\ ĐÚNG\ SAI | ĐÚNG\ GHI\ Đ ) } \l__tt_dmhoa_tl
      { \tl_set:Nn \l__tt_dm_tl { ds } }
    \regex_match:nVT { \A (?: (?: CÂU\ )? TRẮC\ NGHIỆM\ TRẢ\ LỜI\ NGẮN | CÂU\ HỎI\ TRẢ\ LỜI\ NGẮN | TRẢ\ LỜI\ NGẮN ) } \l__tt_dmhoa_tl
      { \tl_set:Nn \l__tt_dm_tl { tln } }
  }
% #2: cách in khi không phải đề mục loại bài
\cs_new_protected:Npn \__tt_dm_in:nn #1 #2
  {
    \__tt_loai_dm:n {#1}
    \str_case:VnF \l__tt_dm_tl
      {
        { tl } { \tt@xoacho \tt@inmuc {#1} }
        { tn } { \tt@xoacho \tt@inmuc {#1} }
        { ds } { \tt@xoacho \tt@inmuc {#1} }
        { tln } { \tt@xoacho \tt@inmuc {#1} }
        { chung } { \par \def\tt@chuchung{#1} \bool_gset_true:N \g__tt_muccho_bool }
      }
      { \tt@xoacho #2 }
  }
\cs_new_protected:Npn \phan #1 { \__tt_dm_in:nn {#1} { \tt@phancu {#1} } }
\cs_new_protected:Npn \muc #1 { \__tt_dm_in:nn {#1} { \tt@inmuc {#1} } }
\ExplSyntaxOff

% Hộp kiến thức / phương pháp
\newtcolorbox{kienthuc}{breakable,enhanced,colback=xanhnhat,colframe=xanh,
  boxrule=0.6pt,arc=2pt,left=6pt,right=6pt,top=4pt,bottom=4pt}
\newtcolorbox{phuongphap}{breakable,enhanced,colback=white,colframe=cam,boxrule=0.5pt,
  borderline west={2.5pt}{0pt}{cam},arc=0pt,left=8pt,top=2pt,bottom=2pt,
  before upper={\textbf{\color{xanh}Phương pháp.}\ }}

% ---------- Bài tự luận ----------
% \begin{bt} Đề bài ... \loigiai{...} \end{bt}
% Nhãn mức độ (tuỳ chọn, chỉ hiện ở bản GV): \begin{bt}[TH]
\newcommand{\tt@nhanmuc}[1]{\ifGV\if\relax\detokenize{#1}\relax\else\ {\footnotesize\color{xam}[Mức #1]}\fi\fi}
\newcounter{bt}
\newenvironment{bt}[1][]{\tt@cho\par\smallskip\refstepcounter{bt}%
  \noindent{\bfseries\color{xanh}Bài \thebt.}\tt@nhanmuc{#1}\ \ignorespaces}%
  {\par}

% Ví dụ có lời giải mẫu (in ở cả hai bản)
\newcounter{vd}
\newenvironment{vd}{\par\smallskip\refstepcounter{vd}%
  \noindent{\bfseries\color{xanh}Ví dụ \thevd.}\ \ignorespaces}{\par}
\newcommand{\giai}[1]{\par{\itshape\bfseries Lời giải.}\ #1\par}

% Lời giải: chỉ in ở bản GV
\newtcolorbox{hopgiai}{breakable,enhanced,colback=white,colframe=xam,boxrule=0pt,
  borderline west={1.5pt}{0pt}{xanh},arc=0pt,left=8pt,right=0pt,top=1pt,bottom=1pt,
  before skip=2pt,after skip=4pt,
  before upper={{\bfseries\itshape\color{xanh}Lời giải.}\ }}
\newcommand{\loigiai}[1]{\ifGV\begin{hopgiai}#1\end{hopgiai}\fi}
% Đáp số ngắn (bài tự luyện): chỉ in ở bản GV
\newcommand{\dapso}[1]{\ifGV\par{\bfseries\color{xanh}Đáp số:}\ #1\par\fi}

% =====================================================================
%  CÂU HỎI THEO ĐỊNH DẠNG MỚI: trắc nghiệm (tn), đúng sai (ds), trả lời ngắn (tln)
%  Ba loại dùng chung bộ đếm "Câu n". Bộ đếm về 1 khi gặp \baimoi hoặc sang PHẦN mới của đề.
%  Đáp án ghi lại tự động để in bảng đáp án bằng \bangdapan (chỉ in ở bản GV).
% =====================================================================
\newcounter{cau}
\newcommand{\tt@daucau}[1]{\tt@cho\par\smallskip\refstepcounter{cau}%
  \noindent{\bfseries\color{xanh}Câu \thecau.}\tt@nhanmuc{#1}\ \ignorespaces}

% ---------- Trắc nghiệm 4 phương án ----------
% \begin{tn}[NB] Đề ... \pa{..}{\dung{..}}{..}{..} \loigiai{...} \end{tn}
% \pa: 4 cột, \paa: 2 cột, \paaa: mỗi phương án một dòng.
% \dung{...}: phương án đúng — bản GV in đậm, gạch chân, và ghi vào bảng đáp án.
\newenvironment{tn}[1][]{\tt@daucau{#1}}{\par}
\newcommand{\tt@chu}{?}
\newcommand{\tt@A}{\textbf{A.}~\def\tt@chu{A}}
\newcommand{\tt@B}{\textbf{B.}~\def\tt@chu{B}}
\newcommand{\tt@C}{\textbf{C.}~\def\tt@chu{C}}
\newcommand{\tt@D}{\textbf{D.}~\def\tt@chu{D}}
\newcommand{\dung}[1]{\tt@ghitn\ifGV\underline{\textbf{#1}}\else#1\fi}
\newlength{\ttlui}\setlength{\ttlui}{0.2in}% các ý (phương án TN, ý đúng sai, ý tự luận, ô đáp số) lùi vào so với chữ "Câu N"
\newcommand{\pa}[4]{\par\noindent\hspace*{\ttlui}%
  \begin{tabularx}{\dimexpr\linewidth-\ttlui\relax}{@{}XXXX@{}}\tt@A#1&\tt@B#2&\tt@C#3&\tt@D#4\end{tabularx}\par}
\newcommand{\paa}[4]{\par\noindent\hspace*{\ttlui}%
  \begin{tabularx}{\dimexpr\linewidth-\ttlui\relax}{@{}XX@{}}\tt@A#1&\tt@B#2\\\tt@C#3&\tt@D#4\end{tabularx}\par}
\newcommand{\paaa}[4]{\par{\leftskip=\ttlui\noindent{\tt@A#1}\par\noindent{\tt@B#2}\par\noindent{\tt@C#3}\par\noindent{\tt@D#4}\par}}

% ---------- Đúng sai: 4 ý a), b), c), d) ----------
% \begin{ds}[TH] Đề ...
%   \ydung{Ý đúng}  \ysai{Ý sai}  \ydung{...}  \ysai{...}
%   \loigiai{...}
% \end{ds}
% Bản GV in "Đúng"/"Sai" ở cuối mỗi ý.
\newcounter{ydsai}
\renewcommand{\theydsai}{\alph{ydsai}}
\newcommand{\tt@y}[2]{\par\refstepcounter{ydsai}\tt@ghids{#1}%
  \noindent\hangindent=\dimexpr\ttlui+1.6em\relax\hangafter=1\hspace*{\ttlui}\makebox[1.6em][l]{\bfseries\theydsai)}#2%
  \ifGV\nobreak\hfill\nobreak{\bfseries\color{xanh}\ #1}\fi\par}
\newcommand{\ydung}[1]{\tt@y{Đúng}{#1}}
\newcommand{\ysai}[1]{\tt@y{Sai}{#1}}
\newenvironment{ds}[1][]{\tt@daucau{#1}\setcounter{ydsai}{0}\tt@batdauds}{\tt@ketds\par}

% ---------- Trả lời ngắn ----------
% \begin{tln}[VD] Đề ... \traloi{2,5} \loigiai{...} \end{tln}
% Dòng riêng có ô điền đáp số; bản GV điền sẵn đáp số vào ô.
\newenvironment{tln}[1][]{\tt@daucau{#1}}{\par}
\newcommand{\traloi}[1]{\tt@ghitln{#1}\par\smallskip\noindent\hspace*{\ttlui}{\bfseries Đáp số:}\ %
  \fbox{\makebox[2.5cm][c]{\rule[-0.2cm]{0pt}{0.65cm}\ifGV{\bfseries\color{xanh}#1}\fi}}\par}

% ---------- Ghi đáp án và in bảng ----------
% \bangdapan: in bảng đáp án các câu đã gặp từ lần gọi trước (chỉ bản GV), rồi xoá để dùng tiếp.
% Đặt ở cuối đề, hoặc cuối mỗi bài học.
\ExplSyntaxOn
\prop_new:N \g__tt_tn_prop
\prop_new:N \g__tt_ds_prop
\prop_new:N \g__tt_tln_prop
\tl_new:N \g__tt_ds_tl
\cs_generate_variant:Nn \prop_gput:Nnn { Nee, Nen }
% Đáp án trắc nghiệm có thể bị ghi nhiều lần (tabularx đo bảng mấy lượt) nên ghi đè theo số câu.
\cs_new_protected:Npn \tt@ghitn
  { \prop_gput:Nee \g__tt_tn_prop { \arabic{cau} } { \tt@chu } }
\cs_new_protected:Npn \tt@batdauds { \tl_gclear:N \g__tt_ds_tl }
\cs_new_protected:Npn \tt@ghids #1
  { \tl_gput_right:Ne \g__tt_ds_tl { \str_if_eq:nnTF {#1} {Đúng} {Đ} {S} } }
\cs_new_protected:Npn \tt@ketds
  { \prop_gput:Nee \g__tt_ds_prop { \arabic{cau} } { \g__tt_ds_tl } }
\cs_new_protected:Npn \tt@ghitln #1
  { \prop_gput:Nen \g__tt_tln_prop { \arabic{cau} } {#1} }

\tl_new:N \l__tt_cau_tl
\tl_new:N \l__tt_da_tl
\tl_new:N \l__tt_bang_tl
\int_new:N \l__tt_dem_int
\dim_new:N \l__tt_rong_dim
\cs_new_protected:Npn \__tt_xa_hang:
  {
    \tl_put_right:Ne \l__tt_bang_tl
      {
        \exp_not:N \begin{tabular}{|l|*{\int_use:N \l__tt_dem_int}{>{\exp_not:N \centering \exp_not:N \arraybackslash}p{\dim_use:N \l__tt_rong_dim}|}} \exp_not:N \hline
        \exp_not:N \bfseries Câu \exp_not:V \l__tt_cau_tl \exp_not:N \\ \exp_not:N \hline
        Đáp~án \exp_not:V \l__tt_da_tl \exp_not:N \\ \exp_not:N \hline
        \exp_not:N \end{tabular} \exp_not:N \par \exp_not:N \smallskip
      }
    \tl_clear:N \l__tt_cau_tl
    \tl_clear:N \l__tt_da_tl
    \int_zero:N \l__tt_dem_int
  }
% #1: danh sách đáp án, #2: tên loại, #3: số câu mỗi hàng, #4: độ rộng ô
\cs_new_protected:Npn \__tt_bang:Nnnn #1#2#3#4
  {
    \prop_if_empty:NF #1
      {
        \dim_set:Nn \l__tt_rong_dim {#4}
        \tl_clear:N \l__tt_bang_tl
        \int_zero:N \l__tt_dem_int
        \prop_map_inline:Nn #1
          {
            \tl_put_right:Nn \l__tt_cau_tl { & ##1 }
            \tl_put_right:Nn \l__tt_da_tl { & ##2 }
            \int_incr:N \l__tt_dem_int
            \int_compare:nNnT \l__tt_dem_int = {#3} { \__tt_xa_hang: }
          }
        \int_compare:nNnT \l__tt_dem_int > 0 { \__tt_xa_hang: }
        \par \noindent { \bfseries \color{xanh} #2 } \par
        \noindent \tl_use:N \l__tt_bang_tl
      }
    \prop_gclear:N #1
  }
\NewDocumentCommand \bangdapan { }
  {
    \ifGV
      \par \medskip
      \begin{center} { \large \bfseries \color{xanh} BẢNG ~ ĐÁP ~ ÁN } \end{center}
      \__tt_bang:Nnnn \g__tt_tn_prop { Trắc~nghiệm~nhiều~phương~án } { 12 } { 0.8cm }
      \__tt_bang:Nnnn \g__tt_ds_prop { Trắc~nghiệm~đúng~sai } { 8 } { 1.4cm }
      \__tt_bang:Nnnn \g__tt_tln_prop { Trắc~nghiệm~trả~lời~ngắn } { 8 } { 1.4cm }
    \else
      \prop_gclear:N \g__tt_tn_prop
      \prop_gclear:N \g__tt_ds_prop
      \prop_gclear:N \g__tt_tln_prop
    \fi
  }
\ExplSyntaxOff

