% Các ý lùi vào \ttlui so với chữ "Câu N"/"Bài N", như phương án trắc nghiệm.
\RequirePackage{tasks,changepage}
\NewTasksEnvironment[label=\alph*),label-width=1.3em,item-indent=1.6em,
