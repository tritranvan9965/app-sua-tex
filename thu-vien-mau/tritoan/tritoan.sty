% ---------- Hình ----------
% Ô giữ chỗ hình vẽ (chờ vẽ lại bằng TikZ): \hinhcho{số trang gốc}{mô tả}
\newcommand{\hinhcho}[2]{\par\begin{center}\fcolorbox{cam}{white}{\parbox{0.8\linewidth}{\footnotesize
  \textbf{\color{cam}[Hình — trang #1]}\ #2}}\end{center}}
% Hình gốc cắt từ PDF nguồn: \hinhgoc{duong/dan/hinh.pdf}{mô tả (không in)}
% Đường dẫn tính từ thư mục ngân hàng của dự án; app (hoặc xuat.py) tự chép file hình khi biên dịch.
% Rộng tối đa 0.3 bề rộng dòng (trước 1.2.10 là 0.6); hình nhỏ hơn giữ nguyên cỡ.
\RequirePackage[export]{adjustbox}
\newcommand{\hinhgoc}[2]{\par\begin{center}\includegraphics[max width=0.3\linewidth]{#1}\end{center}}
% Ảnh của bài (app TriTeX tự chèn, ảnh nằm ở hinh/<tên file>/h001.png... cạnh file .tex):
%   \hinh[tỉ lệ]{đường dẫn}               ảnh căn giữa, rộng tỉ lệ x \linewidth (bỏ trống = 0.5)
%   \hinhphai[tỉ lệ]{đường dẫn}{nội dung}  ảnh nằm bên phải nội dung (bỏ trống = 0.4)
%   \hinhtrai[tỉ lệ]{đường dẫn}{nội dung}  ảnh nằm bên trái nội dung
\newcommand{\hinh}[2][0.5]{\par\begin{center}\includegraphics[width=#1\linewidth]{#2}\end{center}}
\newcommand{\hinhphai}[3][0.4]{\par\noindent\begin{minipage}[t]{\dimexpr\linewidth-#1\linewidth-1em\relax}\vspace{0pt}#3\end{minipage}\hfill%
  \begin{minipage}[t]{#1\linewidth}\vspace{0pt}\raggedleft\includegraphics[width=\linewidth]{#2}\end{minipage}\par}
\newcommand{\hinhtrai}[3][0.4]{\par\noindent\begin{minipage}[t]{#1\linewidth}\vspace{0pt}\raggedright\includegraphics[width=\linewidth]{#2}\end{minipage}\hfill%
  \begin{minipage}[t]{\dimexpr\linewidth-#1\linewidth-1em\relax}\vspace{0pt}#3\end{minipage}\par}
% Chỗ bản số hóa chưa đọc rõ: \chuaro{?}
\newcommand{\chuaro}[1]{\colorbox{yellow}{\textbf{#1}}}

