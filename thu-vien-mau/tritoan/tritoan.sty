% Ghi nhãn thẳng vào .aux (không dùng \label) vì lastpage sang trang ở cuối tài liệu trước khi nhãn kịp in ra.
\newcounter{phande}
\newcommand{\tt@chotphan}{\ifnum\value{phande}>0
  \immediate\write\@auxout{\string\newlabel{tt@hetphan\arabic{phande}}{{\arabic{cau}}{}{}{}{}}}\fi}
\AtEndDocument{\tt@chotphan}
\newcommand{\tt@phande}[2]{\tt@chotphan\stepcounter{phande}\setcounter{cau}{0}%
  \par\medskip\noindent{\bfseries\color{xanh}PHẦN \Roman{phande}. #1}\
  Thí sinh trả lời từ câu 1 đến câu \ref*{tt@hetphan\arabic{phande}}.#2\par\smallskip}
\newcommand{\phantn}{\tt@phande{Câu trắc nghiệm nhiều phương án lựa chọn.}
  { Mỗi câu hỏi thí sinh chỉ chọn một phương án.}}
