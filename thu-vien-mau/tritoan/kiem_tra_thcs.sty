% =====================================================================
%  kiem_tra_thcs.sty — ĐỀ KIỂM TRA CẤP 2 (THCS). In đen trắng.
%  Dùng:  \usepackage{kiem_tra_thcs}   rồi   \mon{TOÁN 9}
%  Cấu trúc: \taodaude, \phantn (I. TRẮC NGHIỆM, 4 phương án), \phantl (II. TỰ LUẬN), \hetde
%  Thông tin đề: \so{..} \truong{..} \kythi{..} \thoigian{..} \made{..}
%  Điểm mỗi phần: \phantn[3,0]  \phantl[7,0]   |   điểm mỗi bài: \begin{bt}\diem{2,0} ...
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kiem_tra_thcs}[2026/11/11 De kiem tra THCS]
\RequirePackage{tritoan}

% In đen trắng (đề thật của trường): màu xanh/cam của tritoan đổi về đen và xám.
\definecolor{xanh}{HTML}{000000}
\definecolor{xanhnhat}{HTML}{F2F2F2}
\definecolor{cam}{HTML}{333333}
\definecolor{camnhat}{HTML}{F2F2F2}
\definecolor{xam}{HTML}{555555}

% ---------- Thông tin đề mặc định cho THCS (ghi đè bằng \so, \truong, \kythi, \thoigian) ----------
\renewcommand{\tt@so}{PHÒNG GIÁO DỤC VÀ ĐÀO TẠO ...}
\renewcommand{\tt@truong}{TRƯỜNG THCS ...}
\renewcommand{\tt@kythi}{ĐỀ KIỂM TRA}
\renewcommand{\tt@thoigian}{90 phút}

% ---------- Đầu đề hai cột: trái là phòng, trường; phải là kỳ thi, môn, thời gian ----------
\renewcommand{\taodaude}{%
  \pagestyle{de}\thispagestyle{de}%
  \noindent\begin{tabularx}{\linewidth}{@{}>{\centering\arraybackslash}p{0.42\linewidth}
      >{\centering\arraybackslash}X@{}}
    \small\tt@so & \bfseries\MakeUppercase{\tt@kythi}\\
    \small\bfseries\tt@truong & \bfseries Môn: \tenmon\\
    \rule[3pt]{0.42\linewidth}{0.4pt} & \itshape Thời gian làm bài: \tt@thoigian, không kể thời gian phát đề\\
    \itshape(Đề có \pageref*{LastPage} trang) &
  \end{tabularx}\par\medskip
  \noindent Họ, tên học sinh: \makebox[6.3cm]{\dotfill}\quad Số báo danh: \makebox[2.6cm]{\dotfill}%
  \if\relax\detokenize\expandafter{\tt@made}\relax\else
    \hfill\fbox{\bfseries Mã đề \tt@made}\fi
  \par\medskip}

% ---------- Phần trắc nghiệm ----------
% \phantn hoặc \phantn[3,0]  -> "PHẦN I. TRẮC NGHIỆM (3,0 điểm)" + lời dặn (câu hỏi dùng môi trường tn)
\RenewDocumentCommand{\phantn}{o}{\tt@phande{TRẮC NGHIỆM\IfValueT{#1}{ (#1 điểm)}.}%
  { Mỗi câu chỉ chọn một phương án đúng.}}

% ---------- Phần tự luận ----------
% \phantl hoặc \phantl[3,0]  -> "PHẦN IV. TỰ LUẬN (3,0 điểm)" (số La Mã tự nối tiếp các phần trước)
% Mỗi bài dùng môi trường bt của tritoan; bài đánh số lại từ 1 trong phần tự luận.
% \diem{2,0} đặt ngay sau \begin{bt}  ->  "Bài 1. (2,0 điểm) ..."
\newcommand{\diem}[1]{\textbf{(#1 điểm)}\ }
\NewDocumentCommand{\phantl}{o}{\tt@chotphan\stepcounter{phande}\setcounter{bt}{0}%
  \par\medskip\noindent{\bfseries PHẦN \Roman{phande}. TỰ LUẬN\IfValueT{#1}{ (#1 điểm)}.}\
  Thí sinh trình bày lời giải đầy đủ.\par\smallskip}
\endinput
